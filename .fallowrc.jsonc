{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  // ctx/ is process/reference material (frozen prototype source, notes,
  // prompts), not app code this migration builds or ships — never analyzed.
  "ignorePatterns": ["ctx/**"],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  // CI-blocking per ctx/notes/260915-prototype-migration-phase3-tooling.md §1:
  // complexity/duplication/circular-dependency/unused-code checks fail CI.
  // Most of fallow's defaults already default to "error" for these
  // categories (unused-files/exports/types, circular-dependencies,
  // boundary-violation, unresolved-imports) — only bumping the two that
  // default to "warn" here.
  "rules": {
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error"
  }
}
